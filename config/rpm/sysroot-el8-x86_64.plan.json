      "arch": "target",
      "purpose": "c-runtime"
    },
    {
      "name": "glibc-minimal-langpack",
      "arch": "target",
      "purpose": "c-runtime"
    },
    {
      "name": "kernel-headers",
      "arch": "target",
      "purpose": "c-runtime"
    },
    {
      "name": "libgcc",
      "arch": "target",
      "purpose": "c-runtime"
    },
    {
      "name": "libstdc++",
      "arch": "target",
      "purpose": "c-runtime"
    },
    {
      "name": "bzip2-devel",
      "arch": "target",
      "purpose": "python"
    },
    {
      "name": "libffi-devel",
      "arch": "target",
      "purpose": "python"
    },
    {
      "name": "libuuid-devel",
