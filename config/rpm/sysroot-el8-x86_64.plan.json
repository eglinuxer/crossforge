{
  "$schema": "https://crossforge.dev/schemas/rpm-plan.schema.json",
  "schema_version": 1,
  "kind": "rpm-plan",
  "identity": {
    "name": "sysroot-el8-x86_64",
    "role": "target-sysroot",
    "distribution": "rocky",
    "release": "8.10",
    "baseline": "el8",
    "arch": "x86_64",
    "target_triple": "x86_64-unknown-linux-gnu"
  },
  "base": {
    "mode": "empty",
    "parent_lock": null,
    "parent_sha256": null
  },
  "repositories": [
    {
      "id": "baseos",
      "baseurl": "https://download.rockylinux.org/pub/rocky/8.10/BaseOS/x86_64/os/"
    }
  ],
  "solver_policy": {
    "allowed_arches": [
      "x86_64",
      "noarch"
    ],
    "install_weak_deps": false,
    "best": true,
    "strict": true,
    "allow_erasing": false,
    "module_platform_id": "platform:el8",
    "enabled_modules": []
  },
  "roots": [
