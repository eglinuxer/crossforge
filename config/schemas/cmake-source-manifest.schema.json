{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/cmake-source-manifest.schema.json",
  "title": "Crossforge authenticated CMake source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "source_component", "source"],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/cmake-source-manifest.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-cmake-source"},
    "source_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "canonical_sha256"],
      "properties": {
        "component": {"const": "sources/cmake"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "archive", "checksums", "signature", "key", "layout"],
      "properties": {
        "version": {"const": "4.4.0"},
        "archive": {"$ref": "#/$defs/source_file"},
        "checksums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "size", "entries"],
          "properties": {
            "file": {"const": "cmake-4.4.0-SHA-256.txt"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "size": {"const": 2015},
            "entries": {"const": 21}
          }
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "size", "verification", "signature_time", "exception"],
          "properties": {
            "file": {"const": "cmake-4.4.0-SHA-256.txt.asc"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "size": {"const": 833},
            "verification": {"const": "cryptographically-valid-expired-key"},
            "signature_time": {"const": "2026-07-09T18:21:38Z"},
            "exception": {"const": "upstream-signing-subkey-expired-before-signing"}
          }
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "size", "primary_fingerprint", "signing_fingerprint", "signing_key_expires_at"],
          "properties": {
            "file": {"const": "CMAKE-RELEASE-KEY.asc"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "size": {"const": 25388},
            "primary_fingerprint": {"const": "cba23971357c2e6590d9efd3ec8fef3a7bfb4eda"},
            "signing_fingerprint": {"const": "c6c265324bbebdc350b513d02d2cef1034921684"},
            "signing_key_expires_at": {"const": "2024-08-12T16:30:38Z"}
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_directory", "member_count", "license_sha256", "readme_sha256", "cmakelists_sha256"],
          "properties": {
            "top_directory": {"const": "cmake-4.4.0"},
            "member_count": {"const": 33033},
            "license_sha256": {"$ref": "#/$defs/sha256"},
            "readme_sha256": {"$ref": "#/$defs/sha256"},
            "cmakelists_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size"],
      "properties": {
        "file": {"const": "cmake-4.4.0.tar.gz"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"const": 13275398}
      }
    }
  }
}
