{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/release-component.schema.json",
  "title": "Crossforge release component projection",
  "description": "A cache-scoped, canonical projection of selected release leaves and upstream component identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "component",
    "scope",
    "dependencies",
    "materials"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/release-component.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "crossforge-release-component"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)*$"
    },
    "scope": {
      "enum": [
        "build",
        "qualification",
        "supply",
        "future"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/material"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "canonical_sha256"
      ],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)*$"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?!\\.\\.(?:/|$))(?:[^/~]|~[01])+(?:/(?!\\.\\.(?:/|$))(?:[^/~]|~[01])+)*$"
        },
        "value": {}
      }
    }
  }
}
