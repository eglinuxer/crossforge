{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/crosspack-plan.schema.json",
  "title": "Crosspack canonical package plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "config_sha256",
    "staging_sha256",
    "staging",
    "target",
    "formats",
    "architectures",
    "elf_audit",
    "debug_symbols",
    "project",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/crosspack-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "crossforge-crosspack-plan"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "staging_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "staging": {
      "$ref": "#/$defs/staging"
    },
    "target": {
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "deb",
          "rpm"
        ]
      }
    },
    "architectures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "rpm": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        }
      }
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "elf_audit": {
      "$ref": "#/$defs/format_elf_audits"
    },
    "debug_symbols": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/debug_symbols"
        }
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "manifest_sha256",
        "variant_id",
        "resolution_sha256",
        "sealed_inventory_sha256",
        "prepared_inventory_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "sealed",
            "observed-unsealed"
          ]
        },
        "manifest_sha256": {
          "$ref": "#/$defs/optional_sha256"
        },
        "variant_id": {
          "$ref": "#/$defs/optional_sha256"
        },
        "resolution_sha256": {
          "$ref": "#/$defs/optional_sha256"
        },
        "sealed_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prepared_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "optional_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "package_names",
        "architecture",
        "architecture_qualification",
        "architectures",
        "summary",
        "description",
        "relations",
        "scripts",
        "contents"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "package_names": {
          "$ref": "#/$defs/package_names"
        },
        "architecture": {
          "enum": [
            "target",
            "independent"
          ]
        },
        "architecture_qualification": {
          "enum": [
            "target-specific",
            "declared-independent"
          ]
        },
        "architectures": {
          "$ref": "#/$defs/package_architectures"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "components",
            "deb",
            "rpm"
          ],
          "properties": {
            "components": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/name"
              }
            },
            "deb": {
              "$ref": "#/$defs/deb_relations"
            },
            "rpm": {
              "$ref": "#/$defs/rpm_relations"
            }
          }
        },
        "scripts": {
          "$ref": "#/$defs/format_scripts"
        },
        "contents": {
          "$ref": "#/$defs/format_contents"
        }
      }
    },
    "format_contents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "$ref": "#/$defs/contents"
        },
        "rpm": {
          "$ref": "#/$defs/contents"
        }
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/file_content"
          },
          {
            "$ref": "#/$defs/symlink_content"
          },
          {
            "$ref": "#/$defs/directory_content"
          }
        ]
      }
    },
    "format_scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "$ref": "#/$defs/scripts"
        },
        "rpm": {
          "$ref": "#/$defs/scripts"
        }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_install",
        "post_install",
        "pre_remove",
        "post_remove"
      ],
      "properties": {
        "pre_install": {
          "$ref": "#/$defs/optional_script"
        },
        "post_install": {
          "$ref": "#/$defs/optional_script"
        },
        "pre_remove": {
          "$ref": "#/$defs/optional_script"
        },
        "post_remove": {
          "$ref": "#/$defs/optional_script"
        }
      }
    },
    "optional_script": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/script"
        }
      ]
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "interpreter",
        "size",
        "sha256"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "interpreter": {
          "const": "/bin/sh"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "epoch",
        "release",
        "vendor",
        "homepage",
        "maintainer",
        "license",
        "section",
        "priority",
        "source_date_epoch"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "epoch": {
          "$ref": "#/$defs/format_epoch"
        },
        "release": {
          "$ref": "#/$defs/format_release"
        },
        "vendor": {
          "$ref": "#/$defs/text"
        },
        "homepage": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "maintainer": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "section": {
          "$ref": "#/$defs/name"
        },
        "priority": {
          "enum": [
            "required",
            "important",
            "standard",
            "optional",
            "extra"
          ]
        },
        "source_date_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      }
    },
    "package_names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]*$"
        },
        "rpm": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*$"
        }
      }
    },
    "package_architectures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "enum": [
            "amd64",
            "arm64",
            "all"
          ]
        },
        "rpm": {
          "enum": [
            "x86_64",
            "aarch64",
            "noarch"
          ]
        }
      }
    },
    "format_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "rpm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "format_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "$ref": "#/$defs/version"
        },
        "rpm": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "deb_relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends",
        "pre_depends",
        "recommends",
        "suggests",
        "conflicts",
        "provides",
        "replaces",
        "breaks"
      ],
      "properties": {
        "depends": {
          "$ref": "#/$defs/relation_list"
        },
        "pre_depends": {
          "$ref": "#/$defs/relation_list"
        },
        "recommends": {
          "$ref": "#/$defs/relation_list"
        },
        "suggests": {
          "$ref": "#/$defs/relation_list"
        },
        "conflicts": {
          "$ref": "#/$defs/relation_list"
        },
        "provides": {
          "$ref": "#/$defs/relation_list"
        },
        "replaces": {
          "$ref": "#/$defs/relation_list"
        },
        "breaks": {
          "$ref": "#/$defs/relation_list"
        }
      }
    },
    "rpm_relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "recommends",
        "suggests",
        "conflicts",
        "provides",
        "obsoletes"
      ],
      "properties": {
        "requires": {
          "$ref": "#/$defs/relation_list"
        },
        "recommends": {
          "$ref": "#/$defs/relation_list"
        },
        "suggests": {
          "$ref": "#/$defs/relation_list"
        },
        "conflicts": {
          "$ref": "#/$defs/relation_list"
        },
        "provides": {
          "$ref": "#/$defs/relation_list"
        },
        "obsoletes": {
          "$ref": "#/$defs/relation_list"
        }
      }
    },
    "relation_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "file_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "type",
        "mode",
        "owner",
        "group",
        "config",
        "size",
        "sha256"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "type": {
          "const": "file"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "group": {
          "$ref": "#/$defs/owner"
        },
        "config": {
          "$ref": "#/$defs/config_type"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "elf": {
          "$ref": "#/$defs/elf"
        }
      }
    },
    "symlink_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "type",
        "mode",
        "owner",
        "group",
        "config",
        "link_target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "type": {
          "const": "symlink"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "group": {
          "$ref": "#/$defs/owner"
        },
        "config": {
          "const": "none"
        },
        "link_target": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "directory_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "type",
        "mode",
        "owner",
        "group",
        "config"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "type": {
          "const": "directory"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "group": {
          "$ref": "#/$defs/owner"
        },
        "config": {
          "const": "none"
        }
      }
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+._@~-]+(?:/[A-Za-z0-9+._@~-]+)*$"
    },
    "destination": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9+._@~-]+(?:/[A-Za-z0-9+._@~-]+)*)?$"
    },
    "mode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "owner": {
      "type": "string",
      "pattern": "^(?:[a-z_][a-z0-9_-]{0,31}|[0-9]{1,10})$"
    },
    "config_type": {
      "enum": [
        "none",
        "config",
        "noreplace"
      ]
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "endianness",
        "machine",
        "type"
      ],
      "properties": {
        "class": {
          "const": 64
        },
        "endianness": {
          "const": "little"
        },
        "machine": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "type": {
          "enum": [
            "relocatable",
            "executable",
            "dynamic",
            "core"
          ]
        },
        "soname": {
          "type": [
            "string",
            "null"
          ]
        },
        "needed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "runpath": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "runpath_resolution": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runpath_resolution"
          }
        },
        "needed_providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/needed_provider"
          }
        },
        "exports_count": {
          "type": "integer",
          "minimum": 0
        },
        "exports_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runpath_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "directory"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "directory": {
          "$ref": "#/$defs/destination"
        }
      }
    },
    "needed_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soname",
        "kind",
        "destination",
        "component",
        "sha256"
      ],
      "properties": {
        "soname": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "package",
            "sysroot"
          ]
        },
        "destination": {
          "$ref": "#/$defs/destination"
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "elf_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readelf_sha256",
        "readelf_version_output_sha256",
        "providers_count",
        "providers_sha256",
        "elf_count"
      ],
      "properties": {
        "readelf_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "readelf_version_output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "providers_count": {
          "type": "integer",
          "minimum": 1
        },
        "providers_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "elf_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "format_elf_audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "$ref": "#/$defs/optional_elf_audit"
        },
        "rpm": {
          "$ref": "#/$defs/optional_elf_audit"
        }
      }
    },
    "optional_elf_audit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/elf_audit"
        }
      ]
    },
    "debug_symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "destination_prefixes",
        "objcopy_sha256",
        "objcopy_version_output_sha256",
        "generated_count",
        "files"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/name"
        },
        "destination_prefixes": {
          "$ref": "#/$defs/format_destinations"
        },
        "objcopy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "objcopy_version_output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_count": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/debug_file"
          }
        }
      }
    },
    "debug_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "runtime_destinations",
        "runtime_sha256",
        "debug_destinations",
        "debug_sha256"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/name"
        },
        "runtime_destinations": {
          "$ref": "#/$defs/format_destinations"
        },
        "runtime_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "debug_destinations": {
          "$ref": "#/$defs/format_destinations"
        },
        "debug_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+._-]*$"
    },
    "format_destinations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb",
        "rpm"
      ],
      "properties": {
        "deb": {
          "$ref": "#/$defs/destination"
        },
        "rpm": {
          "$ref": "#/$defs/destination"
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_~:-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
