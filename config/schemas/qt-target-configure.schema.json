{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/qt-target-configure.schema.json",
  "title": "Crossforge Qt target configure evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "qt_version",
    "identity",
    "install_root",
    "qualification_component",
    "inputs",
    "configuration",
    "tools",
    "features",
    "reviewed_warnings",
    "checks"
  ],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/qt-target-configure.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-qt-target-configure"},
    "qt_version": {"const": "6.8.4"},
    "identity": {"$ref": "#/$defs/identity"},
    "install_root": {
      "type": "string",
      "pattern": "^/opt/crossforge/qualification/qt/6\\.8\\.4/targets/(x86_64|aarch64)-unknown-linux-gnu$"
    },
    "qualification_component": {"$ref": "#/$defs/component"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qt_source_component",
        "xcb_util_cursor_build_sha256",
        "ffmpeg_build_sha256",
        "plan_sha256",
        "patch_sha256",
        "patch_log_sha256"
      ],
      "properties": {
        "qt_source_component": {"$ref": "#/$defs/component"},
        "xcb_util_cursor_build_sha256": {"$ref": "#/$defs/sha256"},
        "ffmpeg_build_sha256": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "patch_sha256": {"$ref": "#/$defs/sha256"},
        "patch_log_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_type", "shared", "examples", "tests", "documentation", "modules"],
      "properties": {
        "build_type": {"const": "Release"},
        "shared": {"const": true},
        "examples": {"const": false},
        "tests": {"const": false},
        "documentation": {"const": false},
        "modules": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmake", "ninja", "cxx", "cxx_target", "host_pkg_config"],
      "properties": {
        "cmake": {"const": "4.4.0"},
        "ninja": {"const": "1.13.2"},
        "cxx": {"const": "15.2.1"},
        "cxx_target": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]},
        "host_pkg_config": {"const": "/usr/bin/pkg-config"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "disabled_reviewed"],
      "properties": {
        "enabled": {"$ref": "#/$defs/string_set"},
        "disabled_reviewed": {"$ref": "#/$defs/string_set"}
      }
    },
    "reviewed_warnings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "documentation-qdoc-disabled-without-clang",
          "clang-lupdate-parser-disabled",
          "qtwebengine-thumb-check-matches-arm64"
        ]
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configure_completed",
        "critical_warnings_absent",
        "target_cxx20_compile",
        "required_modules_enabled",
        "required_features_enabled",
        "host_tools_native",
        "no_target_execution",
        "patch_applied"
      ],
      "properties": {
        "configure_completed": {"const": true},
        "critical_warnings_absent": {"const": true},
        "target_cxx20_compile": {"const": true},
        "required_modules_enabled": {"const": true},
        "required_features_enabled": {"const": true},
        "host_tools_native": {"const": true},
        "no_target_execution": {"const": true},
        "patch_applied": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "triple"],
      "properties": {
        "arch": {"enum": ["x86_64", "aarch64"]},
        "triple": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "canonical_sha256"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "string_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
