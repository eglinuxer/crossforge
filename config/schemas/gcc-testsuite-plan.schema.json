{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/gcc-testsuite-plan.schema.json",
  "title": "Crossforge GCC testsuite plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "profile",
    "gcc_version",
    "unexpected_statuses",
    "site",
    "suites",
    "targets"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/gcc-testsuite-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "gcc-testsuite-plan"
    },
    "profile": {
      "enum": [
        "smoke",
        "full"
      ]
    },
    "gcc_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "host_gcc_major": {
      "const": "8"
    },
    "jobs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "unexpected_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ERROR",
          "FAIL",
          "KFAIL",
          "KPASS",
          "UNRESOLVED",
          "WARNING",
          "XPASS"
        ]
      }
    },
    "site": {
      "$ref": "#/$defs/file_identity"
    },
    "source_patches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_patch"
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/suite"
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "source_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suite",
        "file",
        "sha256",
        "strip",
        "targets"
      ],
      "properties": {
        "id": {
          "enum": [
            "libstdcxx-dumpfullversion",
            "libstdcxx-el8-pr93672-hang",
            "gcc-testsuite-gcov-under-test",
            "testsuite-gcov-under-test",
            "testsuite-cross-gcc-ar"
          ]
        },
        "suite": {
          "enum": [
            "g++.full",
            "gcc.full",
            "libstdc++.full"
          ]
        },
        "file": {
          "enum": [
            "patches/gcc/0001-libstdcxx-use-dumpfullversion.patch",
            "patches/gcc/0002-testsuite-honor-gcov-under-test.patch",
            "patches/gcc/0003-testsuite-honor-cross-gcc-ar.patch",
            "patches/gcc/0004-libstdcxx-skip-el8-pr93672-hang.patch",
            "patches/gcc/0005-gcc-testsuite-honor-gcov-under-test.patch"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "strip": {
          "const": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_patch_target"
          }
        }
      }
    },
    "source_patch_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "before_sha256",
        "after_sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?:gcc|libstdc\\+\\+-v3)/[A-Za-z0-9+_.-]+(?:/[A-Za-z0-9+_.-]+)+$"
        },
        "before_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^tests/gcc/[A-Za-z0-9/_.-]+\\.exp$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sum_file",
        "runtestflags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*$"
        },
        "make_target": {
          "enum": [
            "check-gcc",
            "check-g++",
            "check-target-libgomp"
          ]
        },
        "make_directory": {
          "const": "gcc"
        },
        "driver": {
          "const": "runtest-installed"
        },
        "tool": {
          "const": "libstdc++"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 14400
        },
        "sum_file": {
          "type": "string",
          "pattern": "^(?:\\{target\\}/)?[A-Za-z0-9+_.-]+(?:/[A-Za-z0-9+_.-]+)*\\.sum$"
        },
        "runtestflags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arch",
        "triple",
        "runtime_tiers"
      ],
      "properties": {
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "triple": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
          ]
        },
        "runtime_tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/runtime_tier"
          }
        }
      }
    },
    "runtime_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "board"
      ],
      "properties": {
        "name": {
          "enum": [
            "host-direct",
            "locked-sysroot",
            "clean-rocky"
          ]
        },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "file",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^crossforge-[a-z0-9_-]+$"
            },
            "file": {
              "type": "string",
              "pattern": "^tests/gcc/boards/crossforge-[a-z0-9_-]+\\.exp$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
