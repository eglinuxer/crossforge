{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/qt-target-build.schema.json",
  "title": "Crossforge Qt target build evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "qt_version",
    "identity",
    "install_root",
    "qualification_component",
    "build_environment",
    "inputs",
    "builders",
    "components",
    "libraries",
    "plugins",
    "executables",
    "resources",
    "install_manifest",
    "consumer",
    "checks"
  ],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/qt-target-build.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-qt-target-build"},
    "qt_version": {"const": "6.8.4"},
    "identity": {"$ref": "#/$defs/identity"},
    "install_root": {
      "type": "string",
      "pattern": "^/opt/crossforge/qualification/qt/6\\.8\\.4/targets/(x86_64|aarch64)-unknown-linux-gnu$"
    },
    "qualification_component": {"$ref": "#/$defs/component"},
    "build_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "target", "tier"],
      "properties": {
        "image": {"const": "host-qt-build-locked"},
        "target": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]},
        "tier": {"const": "cross-compile"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_sha256",
        "configure_evidence_sha256",
        "toolchain_file_sha256",
        "patch_sha256",
        "webengine_log_sha256",
        "build_log_sha256",
        "install_log_sha256"
      ],
      "properties": {
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "configure_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "toolchain_file_sha256": {"$ref": "#/$defs/sha256"},
        "patch_sha256": {"$ref": "#/$defs/sha256"},
        "webengine_log_sha256": {"$ref": "#/$defs/sha256"},
        "build_log_sha256": {"$ref": "#/$defs/sha256"},
        "install_log_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "builders": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/file_digest"}
    },
    "components": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "libraries": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/elf"}
    },
    "plugins": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/plugin_elf"}
    },
    "executables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/plugin_elf"}
    },
    "resources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "install_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "unique_entries", "reviewed_duplicates", "sha256"],
      "properties": {
        "entries": {"type": "integer", "minimum": 1},
        "unique_entries": {"type": "integer", "minimum": 1},
        "reviewed_duplicates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prl_files",
            "prl_occurrences",
            "headers",
            "header_occurrences"
          ],
          "properties": {
            "prl_files": {"const": 125},
            "prl_occurrences": {"const": 15},
            "headers": {
              "type": "array",
              "minItems": 5,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "header_occurrences": {"const": 2}
          }
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "consumer": {"$ref": "#/$defs/plugin_elf"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "webengine_build_completed",
        "build_completed",
        "install_completed",
        "required_cmake_packages",
        "required_resources",
        "elf_machine",
        "sonames",
        "dependency_closure",
        "safe_runpath",
        "no_textrel",
        "cmake_consumer_cross_compile",
        "no_target_execution"
      ],
      "properties": {
        "webengine_build_completed": {"const": true},
        "build_completed": {"const": true},
        "install_completed": {"const": true},
        "required_cmake_packages": {"const": true},
        "required_resources": {"const": true},
        "elf_machine": {"const": true},
        "sonames": {"const": true},
        "dependency_closure": {"const": true},
        "safe_runpath": {"const": true},
        "no_textrel": {"const": true},
        "cmake_consumer_cross_compile": {"const": true},
        "no_target_execution": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "triple"],
      "properties": {
        "arch": {"enum": ["x86_64", "aarch64"]},
        "triple": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "canonical_sha256"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "needed_providers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["soname", "provider"],
        "properties": {
          "soname": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1}
        }
      }
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "size", "machine", "soname", "needed", "needed_providers", "runpath"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "machine": {"enum": ["Advanced Micro Devices X86-64", "AArch64"]},
        "soname": {"type": "string", "minLength": 1},
        "needed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "needed_providers": {"$ref": "#/$defs/needed_providers"},
        "runpath": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "plugin_elf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256", "size", "machine", "needed", "needed_providers", "runpath"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "machine": {"enum": ["Advanced Micro Devices X86-64", "AArch64"]},
        "soname": {"type": "string", "minLength": 1},
        "needed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "needed_providers": {"$ref": "#/$defs/needed_providers"},
        "runpath": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
