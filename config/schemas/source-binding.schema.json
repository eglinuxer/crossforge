{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/source-binding.schema.json",
  "title": "Crossforge public source binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "source_commit",
    "release_sha256",
    "repository",
    "digest",
    "platform",
    "platform_manifest_digest",
    "archive"
  ],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/source-binding.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-source-binding"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_sha256": {"$ref": "#/$defs/sha256"},
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "platform": {"const": "linux/amd64"},
    "platform_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "size"],
      "properties": {
        "file": {"type": "string", "pattern": "^crossforge-source-[0-9a-f]{40}\\.tar\\.zst$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1456725209}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
