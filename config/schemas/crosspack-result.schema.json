{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/crosspack-result.schema.json",
  "title": "Crosspack package result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "plan_sha256",
    "nfpm",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/crosspack-result.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "crossforge-crosspack-result"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "nfpm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "version_output_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version_output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "format",
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "deb",
              "rpm"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
