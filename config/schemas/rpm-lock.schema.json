{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/rpm-lock.schema.json",
  "title": "Crossforge verified RPM content lock",
  "description": "Binds a canonical solver transaction to the downloaded RPM headers, signatures, and received bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "transaction",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/rpm-lock.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "rpm-lock"
    },
    "transaction": {
      "$ref": "#/$defs/transaction_reference"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "canonical_sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/].*\\.json$"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "epoch",
        "version",
        "release",
        "arch",
        "nevra",
        "source_rpm"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+_.-]+$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64",
            "noarch"
          ]
        },
        "nevra": {
          "type": "string",
          "minLength": 1
        },
        "source_rpm": {
          "type": "string",
          "pattern": "^.+\\.src\\.rpm$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "fingerprint"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nevra",
        "received_sha256",
        "header",
        "signature"
      ],
      "properties": {
        "nevra": {
          "type": "string",
          "minLength": 1
        },
        "received_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "header": {
          "$ref": "#/$defs/header"
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    }
  }
}
