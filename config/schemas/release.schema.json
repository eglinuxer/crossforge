        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "python_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "adapter",
        "support",
        "patches",
        "source"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "adapter": {
          "enum": [
            "legacy",
            "transition",
            "modern"
          ]
        },
        "support": {
          "enum": [
            "eol",
            "security",
            "bugfix"
          ]
        },
        "patches": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/python_patch"
          }
        },
        "source": {
          "$ref": "#/$defs/python_source"
        }
      }
    },
