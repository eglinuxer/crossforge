{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eglinuxer/crossforge/main/config/schemas/release.schema.json",
  "title": "Crossforge release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "baseline",
    "abi",
    "product",
    "base_image",
    "trust",
    "platforms",
    "host_locks",
    "gts",
    "binutils",
    "qemu",
    "targets",
    "python",
    "vcpkg",
    "nfpm"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/release.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "baseline": {
      "const": "el8"
    },
    "abi": {
      "$ref": "#/$defs/abi"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_repository",
        "stable_channel"
      ],
      "properties": {
        "image_repository": {
          "const": "ghcr.io/eglinuxer/crossforge"
        },
        "stable_channel": {
          "const": "gts15-el8"
        }
      }
    },
    "base_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "index_evidence",
        "manifests"
      ],
      "properties": {
        "repository": {
          "const": "quay.io/rockylinux/rockylinux"
        },
        "tag": {
          "const": "8"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "index_evidence": {
          "const": "evidence/oci/rocky-linux-8.index.json.b64"
        },
        "manifests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amd64",
            "arm64"
          ],
          "properties": {
            "amd64": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "arm64": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rocky_rpm_key"
      ],
      "properties": {
        "rocky_rpm_key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "sha256",
            "fingerprint"
          ],
          "properties": {
            "file": {
              "const": "keys/RPM-GPG-KEY-rockyofficial"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "tool_host",
        "image"
      ],
      "properties": {
        "build": {
          "const": "linux/amd64"
        },
        "tool_host": {
          "const": "linux/amd64"
        },
        "image": {
          "const": "linux/amd64"
        }
      }
    },
    "host_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host-build-common",
        "host-gcc-build",
        "host-python-build",
        "host-runtime"
      ],
      "properties": {
        "host-build-common": {
          "$ref": "#/$defs/host_lock"
        },
        "host-gcc-build": {
          "$ref": "#/$defs/host_lock"
        },
        "host-python-build": {
          "$ref": "#/$defs/host_lock"
        },
        "host-runtime": {
          "$ref": "#/$defs/host_lock"
        }
      }
    },
    "gts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "gcc_version",
        "source"
      ],
      "properties": {
        "major": {
          "const": 15
        },
        "gcc_version": {
          "type": "string",
          "pattern": "^15\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "$ref": "#/$defs/rpm_source"
        }
      }
    },
    "binutils": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "source": {
          "$ref": "#/$defs/rpm_source"
        }
      }
    },
    "qemu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "executor"
      ],
      "properties": {
        "version": {
          "const": "10.2.3"
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "repository",
            "tag",
            "index_digest",
            "index_evidence",
            "manifest_digest",
            "manifest_evidence",
            "binary_path",
            "binary_sha256",
            "provenance",
            "source",
            "cpu",
            "uname_release"
          ],
          "properties": {
            "status": {
              "const": "locked"
            },
            "repository": {
              "const": "docker.io/tonistiigi/binfmt"
            },
            "tag": {
              "const": "qemu-v10.2.3-68"
            },
            "index_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "index_evidence": {
              "const": "evidence/oci/tonistiigi-binfmt-qemu-v10.2.3-68.index.json.b64"
            },
            "manifest_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "manifest_evidence": {
              "const": "evidence/oci/tonistiigi-binfmt-qemu-v10.2.3-68.amd64.manifest.json.b64"
            },
            "binary_path": {
              "const": "/usr/bin/qemu-aarch64"
            },
            "binary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attestation_manifest_digest",
                "attestation_evidence",
                "predicate_digest",
                "predicate_evidence",
                "predicate_size",
                "builder_repository",
                "builder_commit"
              ],
              "properties": {
                "attestation_manifest_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "attestation_evidence": {
                  "const": "evidence/oci/tonistiigi-binfmt-qemu-v10.2.3-68.amd64.attestation.json.b64"
                },
                "predicate_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "predicate_evidence": {
                  "const": "evidence/oci/tonistiigi-binfmt-qemu-v10.2.3-68.amd64.provenance.json.b64"
                },
                "predicate_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "builder_repository": {
                  "const": "https://github.com/tonistiigi/binfmt.git"
                },
                "builder_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "tag",
                "tag_object",
                "tag_evidence",
                "commit",
                "commit_evidence"
              ],
              "properties": {
                "repository": {
                  "const": "https://github.com/qemu/qemu.git"
                },
                "tag": {
                  "const": "v10.2.3"
                },
                "tag_object": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "tag_evidence": {
                  "const": "evidence/git/qemu-v10.2.3.tag.b64"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "commit_evidence": {
                  "const": "evidence/git/qemu-v10.2.3.commit.b64"
                }
              }
            },
            "cpu": {
              "const": "cortex-a53"
            },
            "uname_release": {
              "const": "4.18.0"
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "properties": {
                "arch": {
                  "const": "x86_64"
                },
                "triple": {
                  "const": "x86_64-unknown-linux-gnu"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/target"
            },
            {
              "properties": {
                "arch": {
                  "const": "aarch64"
                },
                "triple": {
                  "const": "aarch64-unknown-linux-gnu"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zstd",
        "versions"
      ],
      "properties": {
        "zstd": {
          "$ref": "#/$defs/python_zstd"
        },
        "versions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/python_version"
                },
                {
                  "properties": {
                    "version": {
                      "pattern": "^3\\.9\\.[0-9]+$"
                    },
                    "adapter": {
                      "const": "legacy"
                    },
                    "support": {
                      "const": "eol"
                    },
                    "patches": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "allOf": [
                            {
                              "$ref": "#/$defs/python_patch"
                            },
                            {
                              "properties": {
                                "file": {
                                  "const": "patches/cpython/3.9/0001-gh-115382-isolate-target-sysconfig.patch"
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "items": false
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/python_version"
                },
                {
                  "properties": {
                    "version": {
                      "pattern": "^3\\.10\\.[0-9]+$"
                    },
                    "adapter": {
                      "const": "legacy"
                    },
                    "support": {
                      "const": "security"
                    },
                    "patches": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "allOf": [
                            {
                              "$ref": "#/$defs/python_patch"
                            },
                            {
                              "properties": {
                                "file": {
                                  "const": "patches/cpython/3.10/0001-gh-115382-isolate-target-sysconfig.patch"
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/python_version"
                },
                {
                  "properties": {
                    "version": {
                      "pattern": "^3\\.11\\.[0-9]+$"
                    },
                    "adapter": {
                      "const": "transition"
                    },
                    "support": {
                      "const": "security"
                    },
                    "patches": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "allOf": [
                            {
                              "$ref": "#/$defs/python_patch"
                            },
                            {
                              "properties": {
                                "file": {
                                  "const": "patches/cpython/3.11/0001-gh-115382-isolate-target-sysconfig.patch"
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "items": false
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/python_version"
                },
                {
                  "properties": {
                    "version": {
                      "pattern": "^3\\.12\\.[0-9]+$"
                    },
                    "adapter": {
                      "const": "modern"
                    },
                    "support": {
                      "const": "security"
                    },
                    "patches": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "prefixItems": [
                        {
                          "allOf": [
                            {
                              "$ref": "#/$defs/python_patch"
                            },
                            {
                              "properties": {
                                "file": {
                                  "const": "patches/cpython/3.12/0001-gh-115382-isolate-target-sysconfig.patch"
                                }
                              }
                            }
                          ]
                        }
                      ],
                      "items": false
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/python_version"
                },
                {
                  "properties": {
                    "version": {
                      "pattern": "^3\\.13\\.[0-9]+$"
                    },
                    "adapter": {
                      "const": "modern"
                    },
                    "support": {
                      "const": "bugfix"
                    },
                    "patches": {
                      "maxItems": 0
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/python_version"
                },
                {
                  "properties": {
                    "version": {
                      "pattern": "^3\\.14\\.[0-9]+$"
                    },
                    "adapter": {
                      "const": "modern"
                    },
                    "support": {
                      "const": "bugfix"
                    },
                    "patches": {
                      "maxItems": 0
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "vcpkg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pin"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/microsoft/vcpkg.git"
        },
        "pin": {
          "$ref": "#/$defs/git_pin"
        }
      }
    },
    "nfpm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "$ref": "#/$defs/artifact_source"
        }
      }
    }
  },
  "$defs": {
    "canonical_json_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "canonical_sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(abi|config|evidence)/[a-zA-Z0-9._/-]+\\.json$"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_manifest",
        "targets",
        "python"
      ],
      "properties": {
        "provider_manifest": {
          "allOf": [
            {
              "$ref": "#/$defs/canonical_json_identity"
            },
            {
              "properties": {
                "file": {
                  "const": "config/abi-providers.json"
                }
              }
            }
          ]
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x86_64",
            "aarch64"
          ],
          "properties": {
            "x86_64": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseline",
                "sysroot_inventory"
              ],
              "properties": {
                "baseline": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/canonical_json_identity"
                    },
                    {
                      "properties": {
                        "file": {
                          "const": "abi/el8/x86_64.json"
                        }
                      }
                    }
                  ]
                },
                "sysroot_inventory": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/canonical_json_identity"
                    },
                    {
                      "properties": {
                        "file": {
                          "const": "evidence/abi/el8-x86_64-sysroot.json"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "aarch64": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "baseline",
                "sysroot_inventory"
              ],
              "properties": {
                "baseline": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/canonical_json_identity"
                    },
                    {
                      "properties": {
                        "file": {
                          "const": "abi/el8/aarch64.json"
                        }
                      }
                    }
                  ]
                },
                "sysroot_inventory": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/canonical_json_identity"
                    },
                    {
                      "properties": {
                        "file": {
                          "const": "evidence/abi/el8-aarch64-sysroot.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_provider_policy",
            "provider_catalogs"
          ],
          "properties": {
            "runtime_provider_policy": {
              "allOf": [
                {
                  "$ref": "#/$defs/canonical_json_identity"
                },
                {
                  "properties": {
                    "file": {
                      "const": "config/python-runtime-providers.json"
                    }
                  }
                }
              ]
            },
            "provider_catalogs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x86_64",
                "aarch64"
              ],
              "properties": {
                "x86_64": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/canonical_json_identity"
                    },
                    {
                      "properties": {
                        "file": {
                          "const": "evidence/abi/el8-x86_64-python-provider-catalog.json"
                        }
                      }
                    }
                  ]
                },
                "aarch64": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/canonical_json_identity"
                    },
                    {
                      "properties": {
                        "file": {
                          "const": "evidence/abi/el8-aarch64-python-provider-catalog.json"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "pending_artifact_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "sha256"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "url": {
          "const": null
        },
        "sha256": {
          "const": null
        }
      }
    },
    "locked_artifact_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "sha256"
      ],
      "properties": {
        "status": {
          "const": "locked"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact_source": {
      "oneOf": [
        {
          "$ref": "#/$defs/pending_artifact_source"
        },
        {
          "$ref": "#/$defs/locked_artifact_source"
        }
      ]
    },
    "pending_python_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "sha256",
        "size",
        "sigstore"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "url": {
          "const": null
        },
        "sha256": {
          "const": null
        },
        "size": {
          "const": null
        },
        "sigstore": {
          "const": null
        }
      }
    },
    "locked_python_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "url",
        "sha256",
        "size",
        "sigstore"
      ],
      "properties": {
        "status": {
          "const": "locked"
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.python\\.org/ftp/python/[0-9]+\\.[0-9]+\\.[0-9]+/Python-[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.xz$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sigstore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verification",
            "bundle_url",
            "bundle_sha256",
            "bundle_size",
            "bundle_evidence",
            "identity",
            "oidc_issuer"
          ],
          "properties": {
            "verification": {
              "const": "archived-unverified"
            },
            "bundle_url": {
              "type": "string",
              "pattern": "^https://www\\.python\\.org/ftp/python/[0-9]+\\.[0-9]+\\.[0-9]+/Python-[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.xz\\.sigstore$"
            },
            "bundle_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bundle_size": {
              "type": "integer",
              "minimum": 1
            },
            "bundle_evidence": {
              "type": "string",
              "pattern": "^evidence/sigstore/cpython-[0-9]+\\.[0-9]+\\.[0-9]+\\.tar\\.xz\\.sigstore\\.b64$"
            },
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "oidc_issuer": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "python_source": {
      "oneOf": [
        {
          "$ref": "#/$defs/pending_python_source"
        },
        {
          "$ref": "#/$defs/locked_python_source"
        }
      ]
    },
    "python_zstd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "license"
      ],
      "properties": {
        "version": {
          "const": "1.5.7"
        },
        "source": {
          "$ref": "#/$defs/zstd_source"
        },
        "license": {
