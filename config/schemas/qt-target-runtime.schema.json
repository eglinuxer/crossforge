{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/qt-target-runtime.schema.json",
  "title": "Crossforge Qt target runtime evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "qt_version",
    "identity",
    "executor",
    "execution",
    "checks"
  ],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/qt-target-runtime.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-qt-target-runtime"},
    "qt_version": {"const": "6.8.4"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "tier",
        "base_image",
        "release_sha256",
        "runtime_qualification",
        "build_evidence_sha256",
        "overlay_evidence_sha256",
        "artifact_tree"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "tier": {"enum": ["clean-rocky", "clean-rocky-qemu", "native-release"]},
        "base_image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index_digest", "manifest_digest"],
          "properties": {
            "index_digest": {"$ref": "#/$defs/oci_digest"},
            "manifest_digest": {"$ref": "#/$defs/oci_digest"}
          }
        },
        "release_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "canonical_sha256", "plan_sha256"],
          "properties": {
            "component": {"const": "future/qt-runtime-qualification"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"},
            "plan_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "build_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "overlay_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "input_rootfs_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entries", "sha256"],
          "properties": {
            "entries": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      },
      "oneOf": [
        {
          "required": ["candidate", "input_rootfs_sha256"],
          "properties": {
            "tier": {"const": "native-release"}
          }
        },
        {
          "properties": {
            "tier": {"enum": ["clean-rocky", "clean-rocky-qemu"]},
            "candidate": false,
            "input_rootfs_sha256": false
          }
        }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["native", "explicit-qemu"]},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "uname_release": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_sha256",
        "exit_code",
        "stdout_sha256",
        "stderr_sha256",
        "loader",
        "loader_sha256",
        "loader_probes",
        "platform_plugin"
      ],
      "properties": {
        "consumer_sha256": {"$ref": "#/$defs/sha256"},
        "exit_code": {"const": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "loader": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "loader_sha256": {"$ref": "#/$defs/sha256"},
        "loader_probes": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/loader_probe"}
        },
        "platform_plugin": {"const": "/usr/plugins/platforms/libqoffscreen.so"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_rocky",
        "dependency_closure",
        "plugin_dependency_closure",
        "offscreen_widget",
        "platform_plugin_loaded",
        "no_build_tree",
        "no_sysroot_marker"
      ],
      "properties": {
        "clean_rocky": {"const": true},
        "dependency_closure": {"const": true},
        "plugin_dependency_closure": {"const": true},
        "offscreen_widget": {"const": true},
        "platform_plugin_loaded": {"const": true},
        "no_build_tree": {"const": true},
        "no_sysroot_marker": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oci_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "triple"],
      "properties": {
        "arch": {"enum": ["x86_64", "aarch64"]},
        "triple": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "repository",
        "digest",
        "platform_manifest_digest",
        "canonical_sha256"
      ],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
        },
        "digest": {"$ref": "#/$defs/oci_digest"},
        "platform_manifest_digest": {"$ref": "#/$defs/oci_digest"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "loader_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "dependencies", "sha256"],
      "properties": {
        "artifact": {"type": "string", "pattern": "^/[^.].+$"},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
