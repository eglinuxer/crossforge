{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/release-control-plane.schema.json",
  "title": "Crossforge release control-plane validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "repository", "environment", "actions", "checks"],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/release-control-plane.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-release-control-plane"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required_reviewer", "prevent_self_review", "deployment_branches"],
      "properties": {
        "name": {"const": "production"},
        "required_reviewer": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
        "prevent_self_review": {"const": false},
        "deployment_branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"const": "main"}
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_workflow_permissions", "can_approve_pull_request_reviews"],
      "properties": {
        "default_workflow_permissions": {"const": "read"},
        "can_approve_pull_request_reviews": {"const": false}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_releases", "private_vulnerability_reporting", "required_review", "main_only", "least_privilege_actions"],
      "properties": {
        "immutable_releases": {"const": true},
        "private_vulnerability_reporting": {"const": true},
        "required_review": {"const": true},
        "main_only": {"const": true},
        "least_privilege_actions": {"const": true}
      }
    }
  }
}
