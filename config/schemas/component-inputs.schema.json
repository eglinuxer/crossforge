{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/component-inputs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "component", "scope", "platform", "targets", "parameters", "files", "dependencies"],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/component-inputs.schema.json"},
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"const": "crossforge-component-inputs"},
    "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"},
    "scope": {"enum": ["build", "qualification", "supply"]},
    "platform": {"const": "linux/amd64"},
    "targets": {"type": "array", "items": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]}},
    "parameters": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mode"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mode": {"type": "string", "pattern": "^[0-7]{4}$"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "inputs_sha256", "artifact_digest"],
        "properties": {
          "component": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$"},
          "inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
