{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/sysroot-lock.schema.json",
  "title": "Crossforge resolved sysroot lock",
  "description": "A complete, content-pinned DNF transaction suitable for offline assembly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "identity",
    "solver",
    "repositories",
    "roots",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/sysroot-lock.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "sysroot-lock"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "solver": {
      "$ref": "#/$defs/solver"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/locked_repository"
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/root_package"
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "release",
        "baseline",
        "arch",
        "target_triple"
      ],
      "properties": {
        "distribution": {
          "const": "rocky"
        },
        "release": {
          "const": "8.10"
        },
        "baseline": {
          "const": "el8"
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "target_triple": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
          ]
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "image",
        "image_digest",
        "dnf_version",
        "libdnf_version",
        "rpm_version",
        "allowed_arches",
        "install_weak_deps",
        "best",
        "strict",
        "allow_erasing"
      ],
      "properties": {
        "implementation": {
          "const": "dnf"
        },
        "image": {
          "const": "quay.io/rockylinux/rockylinux:8"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dnf_version": {
          "type": "string",
          "minLength": 1
        },
        "libdnf_version": {
          "type": "string",
          "minLength": 1
        },
        "rpm_version": {
          "type": "string",
          "minLength": 1
        },
        "allowed_arches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "noarch"
            ]
          }
        },
        "install_weak_deps": {
          "const": false
        },
        "best": {
          "const": true
        },
        "strict": {
          "const": true
        },
        "allow_erasing": {
          "const": false
        }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gpg_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "fingerprint"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "location",
        "checksum"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "locked_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "baseurl",
        "repomd_sha256",
        "metadata",
        "gpg_key"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "baseurl": {
          "type": "string",
          "pattern": "^https://.*/$"
        },
        "repomd_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metadata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/metadata"
          }
        },
        "gpg_key": {
          "$ref": "#/$defs/gpg_key"
        }
      }
    },
    "root_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arch",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+_.-]+$"
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "purpose": {
          "enum": [
            "c-runtime",
            "python"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "epoch",
        "version",
        "release",
        "arch",
        "nevra",
        "repo_id",
        "location",
        "url",
        "repository_checksum",
        "sha256",
        "size",
        "install_size",
        "source_rpm",
        "signing_key_fingerprint",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+_.-]+$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64",
            "noarch"
          ]
        },
        "nevra": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "pattern": "^[^/].*\\.rpm$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://.*\\.rpm$"
        },
        "repository_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "install_size": {
          "type": "integer",
          "minimum": 0
        },
        "source_rpm": {
          "type": "string",
          "pattern": "^.+\\.src\\.rpm$"
        },
        "signing_key_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reason": {
          "enum": [
            "root",
            "dependency"
          ]
        }
      }
    }
  }
}
