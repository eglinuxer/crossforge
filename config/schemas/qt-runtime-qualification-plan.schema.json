{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/qt-runtime-qualification-plan.schema.json",
  "title": "Crossforge Qt runtime qualification plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "status",
    "qt_version",
    "build_qualification",
    "locks",
    "targets",
    "acceptance"
  ],
  "properties": {
    "$schema": {"const": "https://crossforge.dev/schemas/qt-runtime-qualification-plan.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"const": "crossforge-qt-runtime-qualification-plan"},
    "status": {"const": "locked"},
    "qt_version": {"const": "6.8.4"},
    "build_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "plan_file", "plan_sha256"],
      "properties": {
        "component": {"const": "future/qt-qualification"},
        "plan_file": {"const": "config/qt-qualification.json"},
        "plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "locks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/lock"}
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/target"}
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_rocky_runtime",
        "offscreen_widget",
        "platform_plugin_load",
        "plugin_dependency_closure",
        "dependency_closure",
        "native_aarch64_release",
        "artifacts_enter_sdk"
      ],
      "properties": {
        "clean_rocky_runtime": {"const": true},
        "offscreen_widget": {"const": true},
        "platform_plugin_load": {"const": true},
        "plugin_dependency_closure": {"const": true},
        "dependency_closure": {"const": true},
        "native_aarch64_release": {"const": true},
        "artifacts_enter_sdk": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "plan_file",
        "plan_sha256",
        "lock_file",
        "canonical_sha256"
      ],
      "properties": {
        "id": {"enum": ["qt-runtime-x86_64", "qt-runtime-aarch64"]},
        "status": {"const": "locked"},
        "plan_file": {
          "type": "string",
          "pattern": "^config/rpm/qt-runtime-el8-(?:x86_64|aarch64)\\.plan\\.json$"
        },
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "lock_file": {
          "type": "string",
          "pattern": "^locks/qt-runtime-el8-(?:x86_64|aarch64)\\.json$"
        },
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "triple", "runtime_tiers"],
      "properties": {
        "arch": {"enum": ["x86_64", "aarch64"]},
        "triple": {"enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]},
        "runtime_tiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/runtime_tier"}
        }
      }
    },
    "runtime_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "executor"],
      "properties": {
        "tier": {"enum": ["clean-rocky", "clean-rocky-qemu", "native-release"]},
        "executor": {"enum": ["native", "explicit-qemu"]}
      }
    }
  }
}
