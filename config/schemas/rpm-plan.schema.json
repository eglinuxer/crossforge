{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/rpm-plan.schema.json",
  "title": "Crossforge RPM resolution plan",
  "description": "Canonical inputs for resolving a target sysroot or host package transaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "identity",
    "base",
    "repositories",
    "solver_policy",
    "roots"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/rpm-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "rpm-plan"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "solver_policy": {
      "$ref": "#/$defs/solver_policy"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/root"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "distribution",
        "release",
        "baseline",
        "arch",
        "target_triple"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "role": {
          "enum": [
            "target-sysroot",
            "host-build-common",
            "host-gcc-build",
            "host-python-build"
          ]
        },
        "distribution": {
          "const": "rocky"
        },
        "release": {
          "const": "8.10"
        },
        "baseline": {
          "const": "el8"
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "target_triple": {
          "enum": [
            null,
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
          ]
        }
      }
    },
    "base": {
      "oneOf": [
        {
          "$ref": "#/$defs/base_empty"
        },
        {
          "$ref": "#/$defs/base_image"
        },
        {
          "$ref": "#/$defs/base_lock"
        }
      ]
    },
    "base_empty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "parent_lock",
        "parent_sha256"
      ],
      "properties": {
        "mode": {
          "const": "empty"
        },
        "parent_lock": {
          "const": null
        },
        "parent_sha256": {
          "const": null
        }
      }
    },
    "base_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "parent_lock",
        "parent_sha256"
      ],
      "properties": {
        "mode": {
          "const": "image"
        },
        "parent_lock": {
          "const": null
        },
        "parent_sha256": {
          "const": null
        }
      }
    },
    "base_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "parent_lock",
        "parent_sha256"
      ],
      "properties": {
        "mode": {
          "const": "lock"
        },
        "parent_lock": {
          "type": "string",
          "pattern": "^locks/[A-Za-z0-9+_.-]+\\.json$"
        },
        "parent_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "baseurl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "baseurl": {
          "type": "string",
          "pattern": "^https://.*/$"
        }
      }
    },
    "solver_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_arches",
        "install_weak_deps",
        "best",
        "strict",
        "allow_erasing",
        "module_platform_id",
        "enabled_modules"
      ],
      "properties": {
        "allowed_arches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "noarch"
            ]
          }
        },
        "install_weak_deps": {
          "const": false
        },
        "best": {
          "const": true
        },
        "strict": {
          "const": true
        },
        "allow_erasing": {
          "const": false
        },
        "module_platform_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+_.-]+:[A-Za-z0-9+_.-]+$"
        },
        "enabled_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9+_.-]+:[A-Za-z0-9+_.-]+$"
          }
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arch",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+_.-]+$"
        },
        "arch": {
          "enum": [
            "target",
            "noarch",
            "any"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      }
    }
  }
}
