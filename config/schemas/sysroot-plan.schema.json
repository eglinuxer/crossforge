{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/sysroot-plan.schema.json",
  "title": "Crossforge sysroot resolution plan",
  "description": "Planning input only. It is not a resolved or releasable RPM lock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "identity",
    "repositories",
    "solver_policy",
    "roots"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/sysroot-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "sysroot-plan"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/planned_repository"
      }
    },
    "solver_policy": {
      "$ref": "#/$defs/solver_policy"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/root_package"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "release",
        "baseline",
        "arch",
        "target_triple"
      ],
      "properties": {
        "distribution": {
          "const": "rocky"
        },
        "release": {
          "const": "8.10"
        },
        "baseline": {
          "const": "el8"
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "target_triple": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu"
          ]
        }
      }
    },
    "planned_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "baseurl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "baseurl": {
          "type": "string",
          "pattern": "^https://.*/$"
        }
      }
    },
    "solver_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "allowed_arches",
        "install_weak_deps",
        "best",
        "strict",
        "allow_erasing"
      ],
      "properties": {
        "implementation": {
          "const": "dnf"
        },
        "allowed_arches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              "noarch"
            ]
          }
        },
        "install_weak_deps": {
          "const": false
        },
        "best": {
          "const": true
        },
        "strict": {
          "const": true
        },
        "allow_erasing": {
          "const": false
        }
      }
    },
    "root_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arch",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+_.-]+$"
        },
        "arch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "purpose": {
          "enum": [
            "c-runtime",
            "python"
          ]
        }
      }
    }
  }
}
