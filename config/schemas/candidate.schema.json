{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossforge.dev/schemas/candidate.schema.json",
  "title": "Crossforge candidate identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "version",
    "source_commit",
    "release_sha256",
    "repository",
    "digest",
    "platform",
    "platform_manifest_digest",
    "source_bundle"
  ],
  "properties": {
    "$schema": {
      "const": "https://crossforge.dev/schemas/candidate.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "crossforge-candidate"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "platform_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "platform",
        "platform_manifest_digest",
        "archive"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {"const": "linux/amd64"},
        "platform_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "size"],
          "properties": {
            "file": {"type": "string", "pattern": "^crossforge-source-[0-9a-f]{40}\\.tar\\.zst$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 1456725209}
          }
        }
      }
    }
  }
}
